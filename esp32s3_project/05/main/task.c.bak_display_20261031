#include "sys.h"

unsigned int number;

void led_task(void *arg)
{
    ws2812_gpio_init();
    while (1) 
    {
        WS_2812_set(0,0,255);
        vTaskDelay(pdMS_TO_TICKS(100));
    }
}

void printf_task(void *arg)
{
    while (1)
    {
        if(++number >= 100)
        {
            number = 0;
        }
        printf("%d\n",number);
        vTaskDelay(pdMS_TO_TICKS(1000));
    }
}

void ui_task(void *arg)
{
    vTaskDelay(pdMS_TO_TICKS(500));

    /* 显示初始化：05 原版需要初始化两遍才稳定 */
    tft_show_init();
    vTaskDelay(pdMS_TO_TICKS(50));
    tft_show_init();

    /* 先做纯色测试，确认 SPI/背光/屏幕都通 */
    tft_set(0, 239, 0, 283, RED);
    vTaskDelay(pdMS_TO_TICKS(500));
    tft_set(0, 239, 0, 283, GREEN);
    vTaskDelay(pdMS_TO_TICKS(500));
    tft_set(0, 239, 0, 283, BLUE);
    vTaskDelay(pdMS_TO_TICKS(500));
    tft_set(0, 239, 0, 283, BLACK);
    vTaskDelay(pdMS_TO_TICKS(200));

    /*触摸部分*/
    // tft_touch_init();

    /*lvgl部分*/
    my_lvgl_port_init();

    /*ui部分*/
    ui_show();

    while (1)
    {
        lv_timer_handler();
        // tft_iic_read();
        vTaskDelay(pdMS_TO_TICKS(10));
    }
}

void bluetooth_task(void *arg)
{
    bluetooth_init(); 
    while(1)
    {
        vTaskDelay(pdMS_TO_TICKS(10));
    }
}