// VS Code 工作区设置（workspace settings），会被 git 跟踪。
// 这里只放两台电脑都一样、且不含绝对路径的公共配置。
// 本机路径（ESP-IDF、工具链、Python、COM 口、clangd.exe）放在 VS Code 用户设置里，
// 这样公司/宿舍各用自己的路径，拉代码不会互相覆盖。
{
  "C_Cpp.intelliSenseEngine": "default", // 使用 C/C++ 扩展做代码提示和跳转
  "idf.extensionActivationMode": "always", // 打开工程就激活 ESP-IDF 扩展
  "cmake.configureOnOpen": false, // 打开工程时不自动跑 CMake
  "cmake.configureOnEdit": false, // 修改 CMakeLists 时不自动重配
  "cmake.automaticReconfigure": false, // 关闭 CMake 自动重配
  "cmake.autoSelectActiveFolder": false, // 不自动选择 CMake 活动工程
  "cmake.options.advanced": { // 隐藏 CMake 扩展的状态栏按钮
    "build": { // Build 按钮
      "statusBarVisibility": "inherit", // inherit=继承默认显示策略
      "inheritDefault": "hidden" // 默认隐藏
    },
    "launch": { // Launch 按钮
      "statusBarVisibility": "inherit", // inherit=继承默认显示策略
      "inheritDefault": "hidden" // 默认隐藏
    },
    "debug": { // Debug 按钮
      "statusBarVisibility": "inherit", // inherit=继承默认显示策略
      "inheritDefault": "hidden" // 默认隐藏
    }
  },
  "idf.adapterTargetName": "esp32s3", // 目标芯片：ESP32-S3
  "idf.openOcdConfigs": [ // OpenOCD 使用的板级配置
    "board/esp32s3-builtin.cfg" // ESP32-S3 内置 USB-JTAG
  ],
  "idf.flashBaudRate": "460800", // 烧录波特率，必须是字符串
  "idf.monitorBaudRate": "115200", // 串口监视器波特率
  "idf.saveBeforeBuild": true, // 编译前自动保存
  "idf.enableCCache": true, // 启用 ccache 加速重复编译
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json" // C/C++ 扩展的编译数据库；用相对路径，两台电脑通用
}
