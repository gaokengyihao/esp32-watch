// VS Code 工作区设置（workspace settings），只放两台电脑通用的配置。
// ESP-IDF、工具链、Python、COM 口这些本机路径放在 VS Code 用户设置里，
// 这样 08 工程从公司/宿舍拉取时不会被覆盖。
{
  "C_Cpp.intelliSenseEngine": "default",
  "idf.extensionActivationMode": "always",
  "cmake.configureOnOpen": false,
  "cmake.configureOnEdit": false,
  "cmake.automaticReconfigure": false,
  "cmake.autoSelectActiveFolder": false,
  "cmake.options.advanced": {
    "build": {
      "statusBarVisibility": "inherit",
      "inheritDefault": "hidden"
    },
    "launch": {
      "statusBarVisibility": "inherit",
      "inheritDefault": "hidden"
    },
    "debug": {
      "statusBarVisibility": "inherit",
      "inheritDefault": "hidden"
    }
  },
  "idf.adapterTargetName": "esp32s3", // 目标芯片：ESP32-S3
  "idf.openOcdConfigs": [
    "board/esp32s3-builtin.cfg"
  ],
  "idf.flashBaudRate": "460800",
  "idf.monitorBaudRate": "115200",
  "idf.saveBeforeBuild": true,
  "idf.enableCCache": true,
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
  "idf.currentSetup": "C:\\esp\\v6.1-beta1\\esp-idf",
  "idf.flashType": "UART",
  "idf.port": "COM8" // 相对路径，两台电脑通用
}
